{
  "ConnectionStrings": {
    "AzureSql": "YOUR_AZURE_SQL_CONNECTION_STRING"
  },
  "Kafka": {
    "BootstrapServers": "YOUR_VM_IP:9094",
    "ClientId": "orchestrator-service",
    "ConsumerGroups": {
      "LeadQueued": "waterfall-orchestrator-group",
      "LenderResult": "waterfall-result-group"
    }
  },
  "Orchestrator": {
    "MaxRetryCount": 3,
    "RetryDelayMs": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "DedupeWaterfall.Orchestrator": "Debug"
    }
  }
}
