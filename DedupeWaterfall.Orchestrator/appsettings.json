{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sql": {
    "ConnectionString": "Server=localhost;Database=DedupeWaterfall;Trusted_Connection=True;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "dedupe-orchestrator",
    "LeadsQueuedTopic": "dedupe.leads.queued",
    "LenderResultTopic": "dedupe.lender.result",
    "LeadsWonTopic": "dedupe.leads.won",
    "LeadsExhaustedTopic": "dedupe.leads.exhausted",
    "SecurityProtocol": "Plaintext"
  },
  "Orchestrator": {
    "MaxConcurrency": 10,
    "ConsumePollTimeoutMs": 200
  }
}
