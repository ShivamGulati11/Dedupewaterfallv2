{
  "ConnectionStrings": {
    "AzureSql": "Server=localhost;Database=DedupeWaterfall;Trusted_Connection=True;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "orchestrator-service-dev",
    "ConsumerGroups": {
      "LeadQueued": "waterfall-orchestrator-group-dev",
      "LenderResult": "waterfall-result-group-dev"
    }
  },
  "Orchestrator": {
    "MaxRetryCount": 3,
    "RetryDelayMs": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "DedupeWaterfall.Orchestrator": "Debug"
    }
  }
}
